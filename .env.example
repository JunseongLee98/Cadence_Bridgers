# =============================================================================
# Environment variables reference (Amplify / local)
# Copy to .env.local for local dev; set in Amplify Console for deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# Google OAuth (required for Calendar auth)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://www.bridgerscadence.com/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# -----------------------------------------------------------------------------
# AI / LLM (optional – only if using assignment decompose or AI features)
# -----------------------------------------------------------------------------
# Prefers Groq when set; otherwise OpenAI; else Ollama.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Option A: OpenAI
OPENAI_API_KEY=

# Option B: Ollama (self‑hosted or remote)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# Public Cadence URL for ICS subscription links (Google Calendar). Defaults to production when running locally.
NEXT_PUBLIC_APP_URL=https://www.bridgerscadence.com

# Vercel Blob (on Vercel, link Storage → Blob; usually auto-sets BLOB_STORE_ID; legacy projects may use BLOB_READ_WRITE_TOKEN).
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# Alternative: Upstash Redis (Vercel → Storage → Redis). Auto-injects UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Secret for GET /api/telemetry/completions/stats (header x-telemetry-stats-secret or ?secret=).
# TELEMETRY_STATS_SECRET=
